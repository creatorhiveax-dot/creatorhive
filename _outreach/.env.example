# Copy this file to .env and fill it in. Never commit .env.

# Claude API key from https://platform.claude.com (Settings > API keys)
ANTHROPIC_API_KEY=

# Titan business mail login (the same email + password you use at titan.email)
TITAN_EMAIL=marketing@creatorchahiye.com
TITAN_PASSWORD=

# Name and title used in the email sign-off
SENDER_NAME=
SENDER_TITLE=CreatorChahiye
SENDER_PHONE=+91 70655 55395

# Optional settings (defaults shown)
# CLAUDE_MODEL=claude-opus-5-5
# DAILY_SEND_LIMIT=40
# MIN_DELAY_SECONDS=60
# MAX_DELAY_SECONDS=150
# FOLLOWUP_AFTER_DAYS=4
# MAX_FOLLOWUPS=2
# TITAN_SMTP_HOST=smtp.titan.email
# TITAN_SMTP_PORT=465
# TITAN_IMAP_HOST=imap.titan.email
# TITAN_IMAP_PORT=993
# TITAN_SENT_FOLDER=Sent
# EMAIL_LANGUAGE=English
